#include <SPI.h>
#include <LoRa.h>
#include <Adafruit_GPS.h>
#include "SparkFun_SHTC3.h"

#define GPSSerial Serial1

Adafruit_GPS GPS(&GPSSerial);
SHTC3 mySHTC3;

bool loraReady = false;
bool connectedToPi = false;
uint8_t deviceID[12];

constexpr uint8_t STATUS_FAIL = 0;
constexpr uint8_t STATUS_SUCCESS = 1;
constexpr uint8_t STATUS_REGISTER_ACK = 2;
constexpr uint8_t STATUS_REQUEST_READING = 4;

constexpr size_t CONTROL_PACKET_LEN = 13;
constexpr size_t DATA_PACKET_LEN = 31;

void extractDeviceID(uint8_t* out) {
    String id = System.deviceID(); // 24 hex chars = 12 bytes
    for (int i = 0; i < 12; i++) {
        String byteStr = id.substring(i * 2, i * 2 + 2);
        out[i] = (uint8_t)strtol(byteStr.c_str(), nullptr, 16);
    }
}

class Measurements {
  private:
    int16_t temperature = 0;
    uint8_t humidity = 0;
    uint16_t pressure = 0;
    uint8_t soilMoisture = 0;
    uint32_t latitude = 0;   // packed to 24 bits
    uint32_t longitude = 0;  // packed to 24 bits

  public:
    int16_t getTemperature() const { return temperature; }
    uint8_t getHumidity() const { return humidity; }
    uint16_t getPressure() const { return pressure; }
    uint8_t getSoilMoisture() const { return soilMoisture; }
    uint32_t getLatitude() const { return latitude; }
    uint32_t getLongitude() const { return longitude; }

    void readAll() {
        readSHTC3();
        readPressure();
        readSoilMoisture();

        Serial.println();
        Serial.println("Temperature: " + String(temperature / 100.0f) + " C");
        Serial.println("Humidity: " + String(humidity) + " %");
        Serial.println("Pressure: " + String(pressure) + " Pa");
        Serial.println("Soil moisture: " + String(soilMoisture));
        Serial.println("Latitude packed: " + String(latitude));
        Serial.println("Longitude packed: " + String(longitude));
        Serial.println();
    }

    void readSHTC3() {
        mySHTC3.update();
        if (mySHTC3.lastStatus == SHTC3_Status_Nominal) {
            temperature = (int16_t)(mySHTC3.toDegC() * 100.0f);
            humidity = (uint8_t)mySHTC3.toPercent();
        } else {
            Serial.println("SHTC3 error");
        }
    }

    bool readGPS() {
        GPS.read();

        if (GPS.newNMEAreceived()) {
            GPS.parse(GPS.lastNMEA());
        }

        if (!GPS.fix) {
            return false;
        }

        float latitudeRaw = GPS.latitude;
        float longitudeRaw = GPS.longitude;

        int latDegrees = (int)(latitudeRaw / 100.0f);
        float latMinutes = latitudeRaw - (latDegrees * 100.0f);
        float latDecimal = latDegrees + (latMinutes / 60.0f);
        if (GPS.lat == 'S') latDecimal = -latDecimal;

        int lonDegrees = (int)(longitudeRaw / 100.0f);
        float lonMinutes = longitudeRaw - (lonDegrees * 100.0f);
        float lonDecimal = lonDegrees + (lonMinutes / 60.0f);
        if (GPS.lon == 'W') lonDecimal = -lonDecimal;

        latitude = (uint32_t)((latDecimal + 90.0f) * (16777215.0f / 180.0f));
        longitude = (uint32_t)((lonDecimal + 180.0f) * (16777215.0f / 360.0f));

        return true;
    }

    void readPressure() {
        // Placeholder
        pressure = 0;
    }

    void readSoilMoisture() {
        // Placeholder
        soilMoisture = 0;
    }
};

class Transmitter {
  private:
    uint8_t payload[DATA_PACKET_LEN];

  public:
    void transmit(size_t length) {
        LoRa.beginPacket();
        LoRa.write(payload, length);
        LoRa.endPacket();
        Serial.println("Packet sent");
    }

    void formatDataPacket(const Measurements& m) {
        extractDeviceID(deviceID);
        uint32_t timestamp = Time.now();

        memset(payload, 0, sizeof(payload));
        memcpy(payload, deviceID, 12);

        payload[12] = (timestamp >> 24) & 0xFF;
        payload[13] = (timestamp >> 16) & 0xFF;
        payload[14] = (timestamp >> 8) & 0xFF;
        payload[15] = timestamp & 0xFF;

        int16_t temperature = m.getTemperature();
        payload[16] = (temperature >> 8) & 0xFF;
        payload[17] = temperature & 0xFF;

        payload[18] = m.getHumidity();

        uint16_t pressure = m.getPressure();
        payload[19] = (pressure >> 8) & 0xFF;
        payload[20] = pressure & 0xFF;

        payload[21] = m.getSoilMoisture();

        uint32_t latitude = m.getLatitude();
        payload[22] = (latitude >> 16) & 0xFF;
        payload[23] = (latitude >> 8) & 0xFF;
        payload[24] = latitude & 0xFF;

        uint32_t longitude = m.getLongitude();
        payload[25] = (longitude >> 16) & 0xFF;
        payload[26] = (longitude >> 8) & 0xFF;
        payload[27] = longitude & 0xFF;

        payload[28] = 0x00; // flags
        payload[29] = 0x00; // crc placeholder
        payload[30] = 0x00; // crc placeholder
    }
};

class Receiver {
  private:
    uint8_t packet[CONTROL_PACKET_LEN];
    uint8_t status = 0;

  public:
    uint8_t getStatus() const { return status; }

    bool receive(float durationSeconds) {
        memset(packet, 0, sizeof(packet));
        status = 0;

        unsigned long start = millis();
        int packetSize = 0;

        while (millis() - start < (unsigned long)(durationSeconds * 1000.0f)) {
            packetSize = LoRa.parsePacket();
            if (packetSize > 0) break;
        }

        if (packetSize != CONTROL_PACKET_LEN) {
            if (packetSize > 0) {
                while (LoRa.available()) {
                    LoRa.read();
                }
                Serial.println("Unexpected control packet size");
            }
            return false;
        }

        int len = 0;
        while (LoRa.available() && len < CONTROL_PACKET_LEN) {
            packet[len++] = (uint8_t)LoRa.read();
        }

        if (len != CONTROL_PACKET_LEN) {
            Serial.println("Incomplete control packet");
            return false;
        }

        bool idMatches = true;
        for (int i = 0; i < 12; i++) {
            if (packet[i] != deviceID[i]) {
                idMatches = false;
                break;
            }
        }

        status = packet[12];

        Serial.print("Received control status: ");
        Serial.println(status);

        return idMatches;
    }
};

Measurements myMeasurements;
Transmitter myTransmitter;
Receiver myReceiver;

void setup() {
    Serial.begin(115200);
    Serial1.begin(9600);
    waitFor(Serial.isConnected, 10000);

    Wire.begin();
    SPI.begin();

    extractDeviceID(deviceID);

    LoRa.setPins(D10, D3, D2);
    LoRa.setSyncWord(0x12);

    loraReady = LoRa.begin(868E6);
    if (!loraReady) {
        Serial.println("LoRa init failed");
        System.reset();
    }

    // Keep radio settings aligned with Pi side.
    LoRa.setSpreadingFactor(7);
    LoRa.setSignalBandwidth(125E3);
    LoRa.setCodingRate4(5);
    LoRa.enableCrc();

    if (mySHTC3.begin() != SHTC3_Status_Nominal) {
        Serial.println("SHTC3 init failed");
    }

    GPS.begin(9600);
    GPS.sendCommand(PMTK_SET_NMEA_OUTPUT_RMCGGA);
    GPS.sendCommand(PMTK_SET_NMEA_UPDATE_1HZ);
    delay(1000);

    Serial.println("Trying to connect to base node...");

    while (!connectedToPi) {
        myMeasurements.readGPS();
        myTransmitter.formatDataPacket(myMeasurements);
        myTransmitter.transmit(DATA_PACKET_LEN);

        bool match = myReceiver.receive(5.0f);
        if (match && myReceiver.getStatus() == STATUS_REGISTER_ACK) {
            connectedToPi = true;
            break;
        }

        delay(1000);
    }

    Serial.println("Connected to base node");
}

unsigned long lastGpsRead = 0;

void loop() {
    if (millis() - lastGpsRead >= 200) {
        lastGpsRead = millis();
        myMeasurements.readGPS();
    }

    bool match = myReceiver.receive(0.2f);
    if (!match) {
        return;
    }

    if (myReceiver.getStatus() == STATUS_REQUEST_READING) {
        myMeasurements.readAll();
        myTransmitter.formatDataPacket(myMeasurements);
        myTransmitter.transmit(DATA_PACKET_LEN);
    }
}
