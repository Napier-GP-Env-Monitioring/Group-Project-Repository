import os
import spidev
import time
import RPi.GPIO as GPIO
import sqlite3

"""
Protocol

Sensor -> Pi : 31-byte measurement packet
Pi -> Sensor : 13-byte control packet

31-byte sensor packet
0..11   device_id (12 bytes)
12..15  timestamp (uint32)
16..17  temperature * 100 (int16)
18      humidity (uint8)
19..20  pressure (uint16)
21      soil_moisture (uint8)
22..24  latitude packed into 24 bits
25..27  longitude packed into 24 bits
28      flags (uint8)
29..30  crc placeholder (uint16)

13-byte control packet
0..11   device_id (12 bytes)
12      status
"""

RESET_PIN = 25
DIO0_PIN = 22

GPIO.setmode(GPIO.BCM)
GPIO.setup(DIO0_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)

spi = spidev.SpiDev()
spi.open(0, 0)
spi.max_speed_hz = 500000

DB_DIR = "database"
DB_PATH = os.path.join(DB_DIR, "envMonDB.db")

REG_FIFO = 0x00
REG_OP_MODE = 0x01
REG_FRF_MSB = 0x06
REG_FRF_MID = 0x07
REG_FRF_LSB = 0x08
REG_FIFO_ADDR_PTR = 0x0D
REG_FIFO_TX_BASE_ADDR = 0x0E
REG_FIFO_RX_BASE_ADDR = 0x0F
REG_FIFO_RX_CURRENT_ADDR = 0x10
REG_IRQ_FLAGS = 0x12
REG_RX_NB_BYTES = 0x13
REG_PAYLOAD_LENGTH = 0x22
REG_MODEM_CONFIG_1 = 0x1D
REG_MODEM_CONFIG_2 = 0x1E
REG_MODEM_CONFIG_3 = 0x26
REG_LNA = 0x0C
REG_SYNC_WORD = 0x39
REG_DIO_MAPPING_1 = 0x40
REG_VERSION = 0x42

MODE_LONG_RANGE = 0x80
MODE_SLEEP = 0x00
MODE_STDBY = 0x01
MODE_TX = 0x03
MODE_RX_CONTINUOUS = 0x05

IRQ_RX_DONE = 0x40
IRQ_TX_DONE = 0x08
IRQ_PAYLOAD_CRC_ERROR = 0x20

STATUS_FAIL = 0
STATUS_SUCCESS = 1
STATUS_REGISTER_ACK = 2
STATUS_REQUEST_READING = 4

CONTROL_PACKET_LEN = 13
DATA_PACKET_LEN = 31

def spi_read(register):
    response = spi.xfer2([register & 0x7F, 0x00])
    return response[1]

def spi_write(register, value):
    if isinstance(value, (bytes, bytearray, list)):
        spi.xfer2([register | 0x80] + list(value))
    else:
        spi.xfer2([register | 0x80, int(value)])

def reset_module():
    GPIO.setup(RESET_PIN, GPIO.OUT)
    GPIO.output(RESET_PIN, GPIO.LOW)
    time.sleep(0.05)
    GPIO.output(RESET_PIN, GPIO.HIGH)
    time.sleep(0.1)

def set_frequency(frequency_mhz):
    frf = int(frequency_mhz * 1000000.0 / 61.03515625)
    spi_write(REG_FRF_MSB, (frf >> 16) & 0xFF)
    spi_write(REG_FRF_MID, (frf >> 8) & 0xFF)
    spi_write(REG_FRF_LSB, frf & 0xFF)

def init_database():
    os.makedirs(DB_DIR, exist_ok=True)

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS readings (
                device_id TEXT,
                timestamp INTEGER,
                temperature REAL,
                humidity INTEGER,
                pressure INTEGER,
                soil_moisture INTEGER,
                latitude REAL,
                longitude REAL
            )
        """)
        conn.commit()

    print(f"Database ready at: {os.path.abspath(DB_PATH)}")

def write_to_db(device_id_hex, ts, t, h, p, sm, lat, lon):
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO readings (
                device_id,
                timestamp,
                temperature,
                humidity,
                pressure,
                soil_moisture,
                latitude,
                longitude
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (device_id_hex, ts, t, h, p, sm, lat, lon))
        conn.commit()

    print(f"Saved reading for {device_id_hex}")

def device_id_to_hex(device_id):
    return "".join(f"{b:02X}" for b in device_id)

def parse_sensor_packet(payload):
    if payload is None or len(payload) != DATA_PACKET_LEN:
        return None

    device_id = bytes(payload[0:12])

    timestamp = (
        (payload[12] << 24) |
        (payload[13] << 16) |
        (payload[14] << 8) |
        payload[15]
    )

    raw_temp = (payload[16] << 8) | payload[17]
    if raw_temp & 0x8000:
        raw_temp -= 0x10000
    temperature = raw_temp / 100.0

    humidity = payload[18]
    pressure = (payload[19] << 8) | payload[20]
    soil_moisture = payload[21]

    lat_raw = (payload[22] << 16) | (payload[23] << 8) | payload[24]
    lon_raw = (payload[25] << 16) | (payload[26] << 8) | payload[27]

    latitude = (lat_raw * 180.0 / 16777215.0) - 90.0
    longitude = (lon_raw * 360.0 / 16777215.0) - 180.0

    flags = payload[28]
    crc = (payload[29] << 8) | payload[30]

    return {
        "device_id": device_id,
        "timestamp": timestamp,
        "temperature": temperature,
        "humidity": humidity,
        "pressure": pressure,
        "soil_moisture": soil_moisture,
        "latitude": latitude,
        "longitude": longitude,
        "flags": flags,
        "crc": crc,
    }

class Receiver:
    def __init__(self):
        self.payload = None

    def receive(self, timeout=5.0):
        start_time = time.time()

        while (time.time() - start_time) < timeout:
            irq = spi_read(REG_IRQ_FLAGS)

            if irq & IRQ_PAYLOAD_CRC_ERROR:
                spi_write(REG_IRQ_FLAGS, 0xFF)
                print("CRC error")
                continue

            if irq & IRQ_RX_DONE:
                length = spi_read(REG_RX_NB_BYTES)
                current_addr = spi_read(REG_FIFO_RX_CURRENT_ADDR)
                spi_write(REG_FIFO_ADDR_PTR, current_addr)

                self.payload = [spi_read(REG_FIFO) for _ in range(length)]
                spi_write(REG_IRQ_FLAGS, 0xFF)

                if self.payload:
                    print(f"Received packet ({length} bytes)")
                    print("RX payload:", [f"{b:02X}" for b in self.payload])
                    return True

            time.sleep(0.05)

        return False

class Transmitter:
    def __init__(self):
        self.payload = [0] * CONTROL_PACKET_LEN

    def format_control_packet(self, device_id, status):
        if len(device_id) != 12:
            raise ValueError("device_id must be 12 bytes")
        self.payload = list(device_id) + [status]

    def transmit(self):
        spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_STDBY)
        spi_write(REG_FIFO_ADDR_PTR, 0x00)

        for b in self.payload:
            spi_write(REG_FIFO, b)

        spi_write(REG_PAYLOAD_LENGTH, len(self.payload))
        spi_write(REG_IRQ_FLAGS, 0xFF)
        spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_TX)

        while not (spi_read(REG_IRQ_FLAGS) & IRQ_TX_DONE):
            time.sleep(0.01)

        spi_write(REG_IRQ_FLAGS, 0xFF)
        spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_RX_CONTINUOUS)

def init_lora():
    reset_module()

    version = spi_read(REG_VERSION)
    if version != 0x12:
        raise RuntimeError(f"Failed to detect RFM9x. Version read: 0x{version:X}")

    print(f"RFM9x detected. Version: 0x{version:X}")

    spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_SLEEP)
    time.sleep(0.01)
    spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_STDBY)
    time.sleep(0.01)

    set_frequency(868.0)

    spi_write(REG_FIFO_TX_BASE_ADDR, 0x00)
    spi_write(REG_FIFO_RX_BASE_ADDR, 0x00)

    spi_write(REG_LNA, 0x23)
    spi_write(REG_MODEM_CONFIG_1, 0x72)
    spi_write(REG_MODEM_CONFIG_2, 0x74)
    spi_write(REG_MODEM_CONFIG_3, 0x04)
    spi_write(REG_SYNC_WORD, 0x12)
    spi_write(REG_DIO_MAPPING_1, 0x00)
    spi_write(REG_IRQ_FLAGS, 0xFF)

    spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_RX_CONTINUOUS)

receiver = Receiver()
transmitter = Transmitter()
registered_nodes = []

def send_status(device_id, status, repeat=1, gap=0.2):
    transmitter.format_control_packet(device_id, status)

    time.sleep(0.15)

    for _ in range(repeat):
        print(f"Sending status {status} to {device_id_to_hex(device_id)}")
        print("TX payload:", [f"{b:02X}" for b in transmitter.payload])
        transmitter.transmit()
        time.sleep(gap)

def registration_phase():
    if receiver.receive(timeout=5.0):
        packet = parse_sensor_packet(receiver.payload)
        if packet is None:
            return

        device_id = packet["device_id"]
        if device_id not in registered_nodes:
            registered_nodes.append(device_id)
            print(f"Registered node {device_id_to_hex(device_id)}")
        else:
            print(f"Node already known: {device_id_to_hex(device_id)}")

        send_status(device_id, STATUS_REGISTER_ACK, repeat=3, gap=0.3)

def normal_operation_phase():
    for device_id in list(registered_nodes):
        print(f"Requesting reading from {device_id_to_hex(device_id)}")
        send_status(device_id, STATUS_REQUEST_READING)

        success = False
        attempts = 0

        while attempts < 5:
            attempts += 1

            if receiver.receive(timeout=2.0):
                packet = parse_sensor_packet(receiver.payload)
                if packet is None:
                    continue

                if packet["device_id"] != device_id:
                    print("Packet was for a different node")
                    continue

                device_hex = device_id_to_hex(packet["device_id"])
                print(f"Measurement received from {device_hex}")

                write_to_db(
                    device_hex,
                    packet["timestamp"],
                    packet["temperature"],
                    packet["humidity"],
                    packet["pressure"],
                    packet["soil_moisture"],
                    packet["latitude"],
                    packet["longitude"],
                )

                send_status(device_id, STATUS_SUCCESS)
                success = True
                break

        if not success:
            print(f"Failed to get reading from {device_id_to_hex(device_id)}")
            send_status(device_id, STATUS_FAIL)

        time.sleep(0.2)

def main_loop():
    while True:
        if not registered_nodes:
            registration_phase()
        else:
            registration_phase()
            normal_operation_phase()

if __name__ == "__main__":
    try:
        init_lora()
        init_database()
        main_loop()
    except KeyboardInterrupt:
        print("Exiting...")
    finally:
        spi.close()
        GPIO.cleanup()
