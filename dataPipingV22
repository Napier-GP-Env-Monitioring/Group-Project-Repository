import os
import spidev
import time
import RPi.GPIO as GPIO
import sqlite3
from typing import Optional

# =========================
# GPIO + SPI SETUP
# =========================

RESET_PIN = 25
DIO0_PIN = 22

GPIO.setmode(GPIO.BCM)
GPIO.setup(DIO0_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)

spi = spidev.SpiDev()
spi.open(0, 0)
spi.max_speed_hz = 500000

# =========================
# CONSTANTS
# =========================

DEVICE_ID_LEN = 12
MEASUREMENT_PACKET_LEN = 31
CONTROL_PACKET_LEN = 13

STATUS_REG_OK = 1
STATUS_DATA_OK = 2
STATUS_DATA_FAIL = 3
STATUS_REQ_DATA = 4

# LoRa registers
REG_FIFO = 0x00
REG_OP_MODE = 0x01
REG_IRQ_FLAGS = 0x12
REG_RX_NB_BYTES = 0x13
REG_FIFO_RX_CURRENT_ADDR = 0x10
REG_FIFO_ADDR_PTR = 0x0D
REG_PAYLOAD_LENGTH = 0x22
REG_VERSION = 0x42

MODE_LONG_RANGE = 0x80
MODE_SLEEP = 0x00
MODE_STDBY = 0x01
MODE_TX = 0x03
MODE_RX_CONTINUOUS = 0x05

IRQ_RX_DONE = 0x40
IRQ_TX_DONE = 0x08

# =========================
# SPI HELPERS
# =========================

def spi_read(reg):
    return spi.xfer2([reg & 0x7F, 0x00])[1]

def spi_write(reg, val):
    spi.xfer2([reg | 0x80, val])

# =========================
# REAL LoRa INTERFACE
# =========================

class LoRaInterface:
    def __init__(self):
        self.init_radio()

    def reset(self):
        GPIO.setup(RESET_PIN, GPIO.OUT)
        GPIO.output(RESET_PIN, GPIO.LOW)
        time.sleep(0.05)
        GPIO.output(RESET_PIN, GPIO.HIGH)
        time.sleep(0.1)

    def init_radio(self):
        self.reset()

        version = spi_read(REG_VERSION)
        if version != 0x12:
            raise RuntimeError("LoRa module not detected")

        spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_SLEEP)
        time.sleep(0.01)
        spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_STDBY)

        spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_RX_CONTINUOUS)

        print("LoRa ready")

    def send(self, payload: bytes):
        spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_STDBY)
        spi_write(REG_FIFO_ADDR_PTR, 0)

        for b in payload:
            spi_write(REG_FIFO, b)

        spi_write(REG_PAYLOAD_LENGTH, len(payload))
        spi_write(REG_IRQ_FLAGS, 0xFF)
        spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_TX)

        while not (spi_read(REG_IRQ_FLAGS) & IRQ_TX_DONE):
            time.sleep(0.01)

        spi_write(REG_IRQ_FLAGS, 0xFF)
        spi_write(REG_OP_MODE, MODE_LONG_RANGE | MODE_RX_CONTINUOUS)

    def receive(self, timeout=5.0) -> Optional[bytes]:
        start = time.time()

        while time.time() - start < timeout:
            irq = spi_read(REG_IRQ_FLAGS)

            if irq & IRQ_RX_DONE:
                length = spi_read(REG_RX_NB_BYTES)
                addr = spi_read(REG_FIFO_RX_CURRENT_ADDR)
                spi_write(REG_FIFO_ADDR_PTR, addr)

                payload = bytes([spi_read(REG_FIFO) for _ in range(length)])
                spi_write(REG_IRQ_FLAGS, 0xFF)

                print(f"RX: {payload.hex()}")
                return payload

            time.sleep(0.05)

        return None

# =========================
# DATABASE
# =========================

DB_DIR = "database"
DB_PATH = os.path.join(DB_DIR, "envMonDB.db")

def init_db():
    os.makedirs(DB_DIR, exist_ok=True)
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS readings (
                device_id TEXT,
                timestamp INTEGER,
                temperature REAL,
                humidity INTEGER,
                pressure INTEGER,
                soil_moisture INTEGER,
                latitude REAL,
                longitude REAL
            )
        """)

def write_db(data):
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute("""
            INSERT INTO readings VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            data["device_id"].hex(),
            data["timestamp"],
            data["temperature_c"],
            data["humidity"],
            data["pressure"],
            data["soil_moisture"],
            data["latitude"],
            data["longitude"]
        ))
    print("Saved to DB")

# =========================
# PACKET HANDLING
# =========================

def build_control_packet(device_id: bytes, status: int) -> bytes:
    return device_id + bytes([status])

def parse_packet(packet: bytes):
    if len(packet) != MEASUREMENT_PACKET_LEN:
        return None

    return {
        "device_id": packet[0:12],
        "timestamp": int.from_bytes(packet[12:16], "big"),
        "temperature_c": int.from_bytes(packet[16:18], "big", signed=True) / 100,
        "humidity": packet[18],
        "pressure": int.from_bytes(packet[19:21], "big"),
        "soil_moisture": packet[21],
        "latitude": (int.from_bytes(packet[22:25], "big") * 180 / 16777215) - 90,
        "longitude": (int.from_bytes(packet[25:28], "big") * 360 / 16777215) - 180,
    }

# =========================
# BASE NODE LOGIC
# =========================

class BaseNode:
    def __init__(self, radio):
        self.radio = radio
        self.nodes = {}

    def register(self):
        packet = self.radio.receive(5)

        if not packet:
            return

        data = parse_packet(packet)
        if not data:
            return

        dev = data["device_id"]

        if dev not in self.nodes:
            self.nodes[dev] = {}
            print("Registered:", dev.hex())

        self.radio.send(build_control_packet(dev, STATUS_REG_OK))

    def poll(self):
        for dev in list(self.nodes.keys()):
            print("Polling:", dev.hex())

            self.radio.send(build_control_packet(dev, STATUS_REQ_DATA))
            time.sleep(0.3)

            packet = self.radio.receive(3)
            if not packet:
                self.radio.send(build_control_packet(dev, STATUS_DATA_FAIL))
                continue

            data = parse_packet(packet)
            if not data:
                continue

            write_db(data)

            self.radio.send(build_control_packet(dev, STATUS_DATA_OK))

# =========================
# MAIN
# =========================

def main():
    init_db()
    radio = LoRaInterface()
    base = BaseNode(radio)

    while True:
        base.register()
        base.poll()
        time.sleep(1)

if __name__ == "__main__":
    try:
        main()
    finally:
        spi.close()
        GPIO.cleanup()
